# Copy this file to config.env and fill in real values. Never commit config.env.

AWS_REGION=us-east-1
BEDROCK_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0

# Which LLM the agent uses for reading CloudWatch logs: bedrock, openai, gemini, or groq.
# Development default: groq (generous free tier: 14,400 requests/day per model).
# Client/documentation default: bedrock.
LLM_PROVIDER=groq
GEMINI_API_KEY=changeme
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=changeme
GROQ_API_KEY=changeme
GROQ_MODEL=llama-3.3-70b-versatile

# --- Performance knobs ---------------------------------------------------
# How many files the agent processes at the same time. 1 reproduces the old
# one-file-at-a-time behaviour; 8 is the default. Can also be overridden per
# invocation with the payload, e.g. agentcore invoke '{"max_workers": 1}'.
AGENT_MAX_WORKERS=8

# async  = read CloudWatch + ask the LLM on a background thread, so the
#          copy -> verify -> delete pipeline never waits on them (default).
# inline = do it on the critical path, like the original build. Slower, but
#          useful for a side-by-side comparison.
AGENT_REASONING_MODE=async

# Ceiling on simultaneous LLM calls, so parallel workers don't trip the
# provider's per-minute rate limit. Lower this if you see 429 retries.
LLM_MAX_CONCURRENCY=8

# Suffix appended to bucket names to make them globally unique (e.g. your AWS account id)
BUCKET_SUFFIX=changeme

BUCKET_SOURCE=agentcore-demo-source-${BUCKET_SUFFIX}
BUCKET_DEST=agentcore-demo-dest-${BUCKET_SUFFIX}
BUCKET_LOG=agentcore-demo-log-${BUCKET_SUFFIX}
